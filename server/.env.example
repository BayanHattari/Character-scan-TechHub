# Bind address. Keep 0.0.0.0 so other devices on the LAN can reach it.
HOST=0.0.0.0

# Port the server listens on (also used in the URL the wall-display points at)
PORT=3000

# Admin key required to delete photos via the wall-display admin mode
ADMIN_KEY=TechHub-Admin-2026

# Cap on stored photos. Oldest get pruned (file + row) past this.
MAX_PHOTOS=10000

# Optional: override storage paths (defaults are relative to server/)
# PHOTOS_DIR=./photos
# DB_PATH=./data/photos.db
